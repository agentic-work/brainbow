#!/usr/bin/env bash
# brainbow-mcp — stdio MCP launcher with auto-bootstrap.
#
# Spawned by Claude Code (or any MCP client) on stdin/stdout. Before
# handing off to the MCP stdio handler, this shim:
#   (a) starts brainbow REST server if it's not already listening on
#       $BRAINBOW_PORT (default 4444). The REST server is spawned with
#       setsid so it survives this shim and continues serving the viewer
#       for the user.
#   (b) opens the live viewer URL in the user's default browser so the
#       human partner can SEE what the AI is doing — same UX as
#       playwright MCP's `browser_navigate` popping a Chromium window.
#       Tries (in order): wslview, cmd.exe /c start (WSL), xdg-open
#       (Linux), open (macOS). Silently skips if none are available.
#   (c) exec's into the MCP node script. From here on it's pure stdio.
#
# Env vars consumed (all optional):
#   BRAINBOW_URL                  REST base (default http://localhost:$BRAINBOW_PORT)
#   BRAINBOW_PORT                 port (default 4444)
#   BRAINBOW_AUTOSTART_REST       'false' to skip (a)            — default 'true'
#   BRAINBOW_AUTOOPEN_VIEWER      'false' to skip (b)            — default 'true'
#   BRAINBOW_VIEWER_OPENED_FLAG   marker file (don't reopen if exists)
#                                 default $HOME/.cache/brainbow/.viewer-opened-once
#   BRAINBOW_VISION_AUTOSTART     vision narrator on first /api/live
#   BRAINBOW_LOG_TAILS_ENABLED    enable POST /api/log/subscribe
#   AWS_REGION                    for Bedrock vision provider
#   BRAINBOW_VISION_PROVIDER      ollama|bedrock|openai|anthropic
#   BRAINBOW_VISION_MODEL         model id for the provider

set -euo pipefail

# ─── Invocation trace (so we can prove whether Claude even called us) ──
# Single shared trace file across all shim invocations; each line tagged
# with timestamp + PID + PPID so we can correlate to specific /mcp calls.
TRACE_FILE="${BRAINBOW_TRACE_FILE:-/tmp/brainbow-shim-trace.log}"
echo "[$(date '+%H:%M:%S.%3N')] [pid=$$ ppid=${PPID:-?}] BEGIN argv=$# tty=$(tty 2>/dev/null || echo notty)" >> "$TRACE_FILE" 2>/dev/null || true
trap 'echo "[$(date '"'"'+%H:%M:%S.%3N'"'"')] [pid=$$] EXIT rc=$?" >> "$TRACE_FILE" 2>/dev/null || true' EXIT

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

# ─── Locate a usable Node (needed for the free-port probe below) ───────
for candidate in \
    "/home/trent/.nvm/versions/node/v22.22.3/bin/node" \
    "/home/trent/.nvm/versions/node/v24.13.1/bin/node" \
    "$(command -v node 2>/dev/null || true)"; do
  if [ -x "$candidate" ]; then NODE_BIN="$candidate"; break; fi
done
if [ -z "${NODE_BIN:-}" ]; then
  echo "[brainbow-mcp] ERROR: no node binary found" >&2
  exit 1
fi

# ─── Per-Claude port isolation (2026-05-27) ────────────────────────────
# Default behavior is ONE REST server per MCP host (per Claude). Each
# Claude session gets its own port + own brainbow REST process + own
# viewer URL — no cross-Claude sessionId collisions on a shared :4444.
#
# Client key: $PPID (the MCP host that spawned this shim). Stable for the
# entire lifetime of the Claude session. Two Claudes have two PPIDs.
#
# Cached at ~/.cache/brainbow/port-<PPID> so re-invocations within the
# same Claude reuse the same port (and the same setsid'd REST server).
#
# Explicit BRAINBOW_PORT still wins (back-compat, dev override, fixed
# port for a long-lived viewer). To force the legacy shared :4444:
#   BRAINBOW_PORT=4444 claude
#
# To skip the port cache (fresh port every shim invocation):
#   BRAINBOW_PORT_REUSE=false claude
PORT="${BRAINBOW_PORT:-}"
if [ -z "$PORT" ]; then
  CLIENT_KEY="${PPID:-$$}"
  PORT_CACHE_DIR="${BRAINBOW_PORT_CACHE_DIR:-$HOME/.cache/brainbow}"
  PORT_FILE="$PORT_CACHE_DIR/port-$CLIENT_KEY"
  PORT_REUSE="${BRAINBOW_PORT_REUSE:-true}"

  if [ "$PORT_REUSE" = "true" ] && [ -f "$PORT_FILE" ]; then
    CACHED="$(cat "$PORT_FILE" 2>/dev/null || true)"
    if [ -n "$CACHED" ]; then PORT="$CACHED"; fi
  fi

  if [ -z "$PORT" ]; then
    PORT="$("$NODE_BIN" -e "const s=require('net').createServer();s.listen(0,'127.0.0.1',()=>{process.stdout.write(String(s.address().port));s.close();});")"
    if [ -z "$PORT" ]; then
      echo "[brainbow-mcp] WARN: free-port probe failed; falling back to 4444" >&2
      PORT=4444
    fi
    mkdir -p "$PORT_CACHE_DIR" 2>/dev/null || true
    echo "$PORT" > "$PORT_FILE" 2>/dev/null || true
  fi
  echo "[brainbow-mcp] per-Claude port $PORT (key: $CLIENT_KEY, cache: $PORT_FILE)" >&2
fi
export BRAINBOW_PORT="$PORT"
BASE_URL="${BRAINBOW_URL:-http://localhost:$PORT}"
AUTOSTART_REST="${BRAINBOW_AUTOSTART_REST:-true}"
AUTOOPEN_VIEWER="${BRAINBOW_AUTOOPEN_VIEWER:-true}"
# Viewer marker scoped to PORT so each Claude opens its own viewer once.
VIEWER_FLAG="${BRAINBOW_VIEWER_OPENED_FLAG:-$HOME/.cache/brainbow/.viewer-opened-once-$PORT}"

# ─── Vision narrator: cloud by default, NEVER local GPU ────────────────
# Force every brainbow invocation onto cheap+fast Bedrock Haiku 4.5. Local
# Ollama vision (qwen2.5vl) would burn the host GPU's VRAM, which is
# unacceptable on workstations sharing the GPU with other tools.
export BRAINBOW_VISION_PROVIDER="${BRAINBOW_VISION_PROVIDER:-bedrock}"
export BRAINBOW_VISION_MODEL="${BRAINBOW_VISION_MODEL:-us.anthropic.claude-haiku-4-5}"
# Don't auto-start narration on first /api/live — it must be explicit.
export BRAINBOW_VISION_AUTOSTART="${BRAINBOW_VISION_AUTOSTART:-false}"

# ─── (a) Auto-start REST server if not up ──────────────────────────────
# Per-Claude PORT (set above), so each Claude has its own REST process.
# Per-Claude LOG file too — sharing /tmp/brainbow.log caused shim #N to
# truncate shim #N-1's banner+error log, hiding crashes (2026-05-27).
rest_up() { curl -fsS --max-time 1 "$BASE_URL/api/whoami" >/dev/null 2>&1; }

# Default LOG_DIR honors $BRAINBOW_LOG_DIR if caller set it; per-port file
# inside that dir keeps each Claude's server log isolated.
LOG_DIR="${BRAINBOW_LOG_DIR:-/tmp/brainbow}"
LOG="${BRAINBOW_LOG_FILE:-${LOG_DIR}/brainbow-${PORT}.log}"
mkdir -p "$LOG_DIR" 2>/dev/null || true

if [ "$AUTOSTART_REST" = "true" ] && ! rest_up; then
  echo "[brainbow-mcp] REST not detected on $BASE_URL — spawning server.js (log: $LOG)..." >&2

  # setsid + nohup keeps the REST alive after this shim exits. Stdio
  # detached. APPEND (>>) not truncate (>) so concurrent shims don't
  # clobber each other's history.
  setsid nohup env BRAINBOW_PORT="$PORT" "$NODE_BIN" "$REPO_ROOT/server.js" >>"$LOG" 2>&1 </dev/null &
  SPAWNED_PID=$!
  disown 2>/dev/null || true

  # Wait up to 15s for the REST to come up. Longer than the old 8s
  # because slow cold starts (npm imports + Chromium probe) can take 10s+.
  rest_started=false
  for i in $(seq 1 30); do
    if rest_up; then
      rest_started=true
      echo "[brainbow-mcp] REST up on $BASE_URL (pid $SPAWNED_PID, took $((i / 2))s, log: $LOG)" >&2
      break
    fi
    sleep 0.5
  done

  # CRITICAL: if the REST didn't bind in 15s, abort the MCP handshake.
  # The old code printed a warning then exec'd mcp-server.js anyway,
  # which left the Claude MCP client hanging on HTTP calls to a dead
  # port until its 30s handshake timeout. That UX is unacceptable —
  # the user sees "MCP server brainbow connection timed out" with no
  # signal of why. Fail loud, fail fast.
  if [ "$rest_started" = "false" ]; then
    echo "[brainbow-mcp] FATAL: REST didn't bind $BASE_URL in 15s." >&2
    echo "[brainbow-mcp] Server log tail (last 30 lines):" >&2
    tail -30 "$LOG" 2>/dev/null >&2 || echo "[brainbow-mcp] (log file unreadable: $LOG)" >&2
    echo "[brainbow-mcp] Aborting MCP handshake. The Claude MCP client will see this" >&2
    echo "[brainbow-mcp] as a connection error, NOT a silent timeout." >&2
    exit 1
  fi
fi

# ─── (b) Auto-open viewer in user's browser ────────────────────────────
# Skipped if the marker file exists (already opened once for this user)
# OR if no opener is available (headless host).
open_viewer() {
  local url="$1"
  if command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    xdg-open "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 && return 0
  fi
  return 1
}

if [ "$AUTOOPEN_VIEWER" = "true" ] && [ ! -f "$VIEWER_FLAG" ]; then
  mkdir -p "$(dirname "$VIEWER_FLAG")" 2>/dev/null || true
  # CRITICAL: fire-and-forget in the background. If we wait for the
  # opener (wslview / cmd.exe / xdg-open / open), ANY delay here eats
  # Claude's MCP-init race window. Other MCPs (context7, figma, …)
  # hand back their tool catalog in <1s; brainbow has to do the same.
  # The viewer is best-effort UX, not a registration prerequisite.
  (
    if timeout 5 bash -c "$(declare -f open_viewer); open_viewer \"$BASE_URL/\""; then
      touch "$VIEWER_FLAG" 2>/dev/null || true
      echo "[brainbow-mcp] viewer opened at $BASE_URL/ (background, flag: $VIEWER_FLAG)" >> "$TRACE_FILE" 2>/dev/null || true
    else
      echo "[brainbow-mcp] viewer auto-open failed/stalled (background)" >> "$TRACE_FILE" 2>/dev/null || true
    fi
  ) &
  disown 2>/dev/null || true
  echo "[brainbow-mcp] viewer auto-open dispatched (background, $BASE_URL/)" >&2
fi

# ─── (c) Hand off to the MCP stdio server ──────────────────────────────
exec "$NODE_BIN" "$REPO_ROOT/src/mcp-server.js"
