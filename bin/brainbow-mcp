#!/usr/bin/env bash
# brainbow-mcp — stdio MCP launcher with auto-bootstrap.
#
# Architecture (2026-05-27 rewrite):
#
#   ONE shared REST server per host (default :4444), MANY MCP clients,
#   each with its own unique sessionId. The brainbow REST already supports
#   N concurrent sessions (each owns a Puppeteer Chromium process keyed by
#   sessionId — see src/session.js). The only thing the launcher needs to
#   do is ensure every MCP client picks a unique default sessionId so two
#   Claudes never collide on `sessionId="default"`.
#
#   This replaces the 9652846/179ddab per-Claude PORT scheme (which was
#   the wrong abstraction layer — it spawned a REST + Chromium per Claude,
#   wasting RAM and exposing race conditions on shim startup).
#
# Spawned by Claude Code (or any MCP client) on stdin/stdout. Before
# handing off to the MCP stdio handler, this shim:
#   (a) Picks a stable unique BRAINBOW_SESSION for this Claude (PPID-based
#       so /mcp reconnects within one Claude keep the same session +
#       browser window).
#   (b) Starts brainbow REST server if it's not already listening on
#       $BRAINBOW_PORT (default 4444). The REST server is spawned with
#       setsid so it survives this shim and serves all other Claudes too.
#   (c) Opens the live viewer URL (with this Claude's sessionId in the
#       query string) so the human sees this AI's browser, not the other
#       Claude's. Each Claude pops its own viewer tab.
#   (d) exec's into the MCP node script. From here on it's pure stdio.
#
# Env vars consumed (all optional):
#   BRAINBOW_URL                  REST base (default http://localhost:$BRAINBOW_PORT)
#   BRAINBOW_PORT                 port (default 4444 — shared across Claudes)
#   BRAINBOW_SESSION              session ID (default: auto-derived per PPID)
#   BRAINBOW_AUTOSTART_REST       'false' to skip (b)            — default 'true'
#   BRAINBOW_AUTOOPEN_VIEWER      'false' to skip (c)            — default 'true'
#   BRAINBOW_VIEWER_OPENED_FLAG   marker file (don't reopen if exists)
#                                 default $HOME/.cache/brainbow/.viewer-opened-once-<SESSION>
#   BRAINBOW_VISION_AUTOSTART     vision narrator on first /api/live
#   BRAINBOW_LOG_TAILS_ENABLED    enable POST /api/log/subscribe
#   AWS_REGION                    for Bedrock vision provider
#   BRAINBOW_VISION_PROVIDER      ollama|bedrock|openai|anthropic
#   BRAINBOW_VISION_MODEL         model id for the provider

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

# ─── Locate a usable Node ──────────────────────────────────────────────
for candidate in \
    "/home/trent/.nvm/versions/node/v22.22.3/bin/node" \
    "/home/trent/.nvm/versions/node/v24.13.1/bin/node" \
    "$(command -v node 2>/dev/null || true)"; do
  if [ -x "$candidate" ]; then NODE_BIN="$candidate"; break; fi
done
if [ -z "${NODE_BIN:-}" ]; then
  echo "[brainbow-mcp] ERROR: no node binary found" >&2
  exit 1
fi

# ─── Shared port (default 4444 — one REST per host) ────────────────────
PORT="${BRAINBOW_PORT:-4444}"
export BRAINBOW_PORT="$PORT"
BASE_URL="${BRAINBOW_URL:-http://localhost:$PORT}"

# ─── Per-Claude unique sessionId (PPID-derived, stable per Claude) ─────
# Each MCP host (Claude process) is the parent of this shim, so $PPID is
# stable for the lifetime of that Claude session (across /mcp reconnects
# within one Claude). Different Claudes have different PIDs → different
# session IDs → different Chromium browser windows on the shared REST.
#
# Cached at ~/.cache/brainbow/session-<PPID> so the SAME session is
# reused if Claude reconnects (otherwise each /mcp would spawn a new
# Chromium and lose the existing browser state).
#
# Explicit BRAINBOW_SESSION env override always wins (lets one Claude
# control multiple sessions, or share a session across hosts).
if [ -z "${BRAINBOW_SESSION:-}" ]; then
  SESSION_CACHE_DIR="${BRAINBOW_SESSION_CACHE_DIR:-$HOME/.cache/brainbow}"
  SESSION_FILE="$SESSION_CACHE_DIR/session-${PPID:-$$}"
  if [ -f "$SESSION_FILE" ]; then
    BRAINBOW_SESSION="$(cat "$SESSION_FILE" 2>/dev/null || true)"
  fi
  if [ -z "${BRAINBOW_SESSION:-}" ]; then
    # Format: claude-<PPID>-<5char hex> — readable + sortable + unique.
    SUFFIX="$("$NODE_BIN" -e "process.stdout.write(require('crypto').randomBytes(3).toString('hex').slice(0,5))" 2>/dev/null || echo "$RANDOM" | head -c 5)"
    BRAINBOW_SESSION="claude-${PPID:-$$}-${SUFFIX}"
    mkdir -p "$SESSION_CACHE_DIR" 2>/dev/null || true
    echo "$BRAINBOW_SESSION" > "$SESSION_FILE" 2>/dev/null || true
  fi
fi
export BRAINBOW_SESSION
echo "[brainbow-mcp] session=$BRAINBOW_SESSION rest=$BASE_URL" >&2

AUTOSTART_REST="${BRAINBOW_AUTOSTART_REST:-true}"
AUTOOPEN_VIEWER="${BRAINBOW_AUTOOPEN_VIEWER:-true}"
# Viewer marker scoped per-session so each Claude opens its own viewer tab.
VIEWER_FLAG="${BRAINBOW_VIEWER_OPENED_FLAG:-$HOME/.cache/brainbow/.viewer-opened-once-$BRAINBOW_SESSION}"

# ─── Vision narrator: cloud by default, NEVER local GPU ────────────────
export BRAINBOW_VISION_PROVIDER="${BRAINBOW_VISION_PROVIDER:-bedrock}"
export BRAINBOW_VISION_MODEL="${BRAINBOW_VISION_MODEL:-us.anthropic.claude-haiku-4-5}"
export BRAINBOW_VISION_AUTOSTART="${BRAINBOW_VISION_AUTOSTART:-false}"

# ─── (b) Auto-start REST server if not up ──────────────────────────────
rest_up() { curl -fsS --max-time 1 "$BASE_URL/api/whoami" >/dev/null 2>&1; }

LOG_DIR="${BRAINBOW_LOG_DIR:-/tmp/brainbow}"
LOG="${BRAINBOW_LOG_FILE:-${LOG_DIR}/brainbow-${PORT}.log}"
mkdir -p "$LOG_DIR" 2>/dev/null || true

if [ "$AUTOSTART_REST" = "true" ] && ! rest_up; then
  echo "[brainbow-mcp] REST not on $BASE_URL — spawning shared server.js (log: $LOG)..." >&2
  setsid nohup env BRAINBOW_PORT="$PORT" "$NODE_BIN" "$REPO_ROOT/server.js" >>"$LOG" 2>&1 </dev/null &
  SPAWNED_PID=$!
  disown 2>/dev/null || true

  rest_started=false
  for i in $(seq 1 30); do
    if rest_up; then
      rest_started=true
      echo "[brainbow-mcp] REST up on $BASE_URL (pid $SPAWNED_PID, took $((i / 2))s, log: $LOG)" >&2
      break
    fi
    sleep 0.5
  done

  if [ "$rest_started" = "false" ]; then
    echo "[brainbow-mcp] FATAL: REST didn't bind $BASE_URL in 15s." >&2
    echo "[brainbow-mcp] Server log tail (last 30 lines):" >&2
    tail -30 "$LOG" 2>/dev/null >&2 || echo "[brainbow-mcp] (log file unreadable: $LOG)" >&2
    exit 1
  fi
fi

# ─── (c) Auto-open viewer in user's browser ────────────────────────────
# Viewer URL includes ?sessionId=… so this Claude's browser tab shows
# THIS Claude's session — not the other Claude's. Different sessionIds
# → different tabs on the shared viewer host.
open_viewer() {
  local url="$1"
  if command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    xdg-open "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 && return 0
  fi
  return 1
}

VIEWER_URL="${BASE_URL}/?sessionId=${BRAINBOW_SESSION}"
if [ "$AUTOOPEN_VIEWER" = "true" ] && [ ! -f "$VIEWER_FLAG" ]; then
  mkdir -p "$(dirname "$VIEWER_FLAG")" 2>/dev/null || true
  if open_viewer "$VIEWER_URL"; then
    touch "$VIEWER_FLAG" 2>/dev/null || true
    echo "[brainbow-mcp] viewer opened at $VIEWER_URL (flag: $VIEWER_FLAG)" >&2
  else
    echo "[brainbow-mcp] no viewer opener available — open $VIEWER_URL manually" >&2
  fi
fi

# ─── (d) Hand off to the MCP stdio server ──────────────────────────────
exec "$NODE_BIN" "$REPO_ROOT/src/mcp-server.js"
